# =============================================================================
# ThyroAI Platform — copy to .env and adjust as needed
#   cp .env.example .env
#   docker compose up --build -d
# =============================================================================

# --- PostgreSQL (shared instance; two databases created on first boot) -------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_me_postgres
POSTGRES_PORT=5432

# --- RabbitMQ ----------------------------------------------------------------
RABBITMQ_USER=orthanc
RABBITMQ_PASS=change_me_rabbit
RABBITMQ_AMQP_PORT=5672
RABBITMQ_UI_PORT=15672
QUEUE_NAME=orthanc.stable-study

# --- Orthanc DICOM server ----------------------------------------------------
ORTHANC_NAME=ThyroAI-Orthanc
ORTHANC_DICOM_AET=ORTHANC
# Host ports mapped to Orthanc. Defaults avoid a common Docker Desktop
# phantom bind on 8042; change back to 8042/4242 if those ports are free.
ORTHANC_API_PORT=18042
ORTHANC_DICOM_PORT=14242
ORTHANC_ADMIN_USER=admin
ORTHANC_ADMIN_PASS=change_me_admin
ORTHANC_BASIC_USER=orthanc
ORTHANC_BASIC_PASS=change_me_orthanc

# --- MinIO (S3-compatible DICOM archive) -------------------------------------
MINIO_ROOT_USER=minio
MINIO_ROOT_PASSWORD=change_me_minio
MINIO_BUCKET=medical-imaging
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
S3_REGION=us-east-1

# --- Clinical backend --------------------------------------------------------
CLINICAL_BACKEND_PORT=8080
# Generate your own: openssl rand -base64 48
JWT_SECRET=REPLACE_WITH_BASE64_SECRET
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002,http://localhost:5173,http://localhost:5174,http://localhost:5175

# Shared secret between imaging-service and clinical-backend (/api/v1/dicom/ingest).
# Must be non-empty when THYROAI_INGEST_ENABLED=true.
THYROAI_INGEST_KEY=change_me_ingest_key
THYROAI_INGEST_ENABLED=true

# --- Frontends (host ports) --------------------------------------------------
DOCTOR_PANEL_PORT=3000
ADMIN_PANEL_PORT=3001
SUPER_ADMIN_PANEL_PORT=3002
